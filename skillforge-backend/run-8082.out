        c1_0.content_id,
        c1_0.content_text,
        c1_0.content_type,
        c1_0.content_url,
        c1_0.created_at,
        c1_0.difficulty_level,
        c1_0.duration_minutes,
        c1_0.metadata,
        c1_0.order_index,
        c1_0.parent_content_id,
        c1_0.title,
        c1_0.updated_at 
    from
        learning_content c1_0 
    where
        c1_0.goal_id=?
